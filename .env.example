# Firebase Web App configuration
# Copy this file to .env.local for local development, then replace every value
# with the Firebase Console > Project settings > Your apps > Web app values.
#
# These VITE_ values are public browser configuration identifiers. Never put a
# Firebase service-account JSON key or any other server secret in this file.
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# EdgeStore (optional; required only when cloud uploads are enabled)
# EDGE_STORE_ACCESS_KEY=YOUR_EDGE_STORE_ACCESS_KEY
# EDGE_STORE_SECRET_KEY=YOUR_EDGE_STORE_SECRET_KEY
